{
  "private": true,
  "name": "@codehud/workspace",
  "version": "0.1.0",
  "description": "Drive Claude Code and Codex from smart glasses: one app, no hosted server, one adapter per device.",
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "build": "pnpm --filter=./packages/** -r build",
    "test": "pnpm --filter @codehud/test build && pnpm --filter @codehud/test start",
    "format": "prettier --write \"**/*.{ts,cts,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,cts,mts}\"",
    "evidence": "evidence"
  },
  "keywords": [
    "smart-glasses",
    "coding-agent",
    "claude-code",
    "codex",
    "hud",
    "wearable"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/codehud"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "catalog:typescript",
    "@ttsc/evidence": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "@wrtnlabs/evidence": "catalog:typescript",
    "prettier": "catalog:typescript",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
