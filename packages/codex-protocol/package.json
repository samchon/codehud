{
  "name": "@codehud/codex-protocol",
  "version": "0.1.0",
  "description": "Codex app-server protocol types, generated by the codex binary itself.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build"
  },
  "author": "Samchon",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@ttsc/lint": "catalog:typescript",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  },
  "codex": {
    "generatedFrom": "codex-cli 0.154.0",
    "generatedOn": "2026-09-18",
    "command": "codex app-server generate-ts --out packages/codex-protocol/src"
  }
}
