{
  "name": "@codehud/projection",
  "version": "0.1.0",
  "description": "Pure reducer and composer turning a coding-agent event stream into glanceable head-up display frames.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "prepack": "pnpm run build"
  },
  "keywords": ["hud", "reducer", "smart-glasses", "coding-agent"],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/codehud"
  },
  "files": ["lib", "src", "package.json", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@codehud/interface": "workspace:^"
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
