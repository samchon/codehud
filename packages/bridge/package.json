{
  "name": "@codehud/bridge",
  "version": "0.1.0",
  "description": "The local bridge process: duplex transport, pairing, session multiplexing, and observation retention.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf lib && ttsc",
    "start": "ttsx -P tsconfig.json src/bin.ts",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "tgrid",
    "websocket",
    "bridge",
    "pairing",
    "session"
  ],
  "author": "Samchon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/codehud"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@codehud/agent": "workspace:^",
    "@codehud/interface": "workspace:^",
    "qrcode-terminal": "catalog:net",
    "tgrid": "catalog:net"
  },
  "devDependencies": {
    "@ttsc/evidence": "catalog:typescript",
    "@ttsc/lint": "catalog:typescript",
    "@types/node": "catalog:utils",
    "@types/qrcode-terminal": "catalog:net",
    "rimraf": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  },
  "bin": {
    "codehud-bridge": "bin/codehud-bridge.js"
  }
}
